{
  "name": "nova-bots",
  "version": "0.2.6",
  "description": "Nova Bots: a team of long-lived Bots with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "bot",
    "multi-agent",
    "agents"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "src/office/",
    "client.js",
    "office.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "deep-view": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jahanzaib211/nova-bots.git"
  },
  "homepage": "https://github.com/Jahanzaib211/nova-bots",
  "bugs": {
    "url": "https://github.com/Jahanzaib211/nova-bots/issues"
  }
}
